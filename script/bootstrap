#!/bin/bash
# Initial install script to run on devpod
set -euo pipefail

log() { printf '%s\n' "[INFO] $*"; }
warn() { printf '%s\n' "[WARN] $*" >&2; }
err() { printf '%s\n' "[ERROR] $*" >&2; }

echo "Running DevPod dotfiles install script..."

# --- Install chezmoi & configure dotfile ---
if sh -c "$(curl -fsLS get.chezmoi.io)" -- init --apply git@github.com:francisco-cardenas/DevPod-dots.git; then
  log "Installed chezmoi and ran init apply successfully"
  log "cleaning up binary of chezmoi. Chezmoi is to be used from mise install."

  # This install of chezmoi is temporary for the bootstrap. Mise will finish installing it
  rm -rf bin # Testing without removal
else
  err "Failed to install chezmoi or run init --apply" >&2
  exit 1
fi

# --- Switch to zsh if available ---
USER_NAME="$(whoami)"
ZSH_BIN="$(command -v zsh || true)"

log "Changing login shell for $USER_NAME to $ZSH_BIN"
if sudo -n chsh -s "$ZSH_BIN" "$USER_NAME"; then
  log "Shell changed successfully for $USER_NAME"
else
  err "Failed to change shell (need root or passwordless sudo)"
  exit 1
fi

# --- Exit ---
echo "[OK] Bootstrap complete."
