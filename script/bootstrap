#!/bin/bash
# Initial install script to run on devpod
set -euo pipefail

log() { printf '%s\n' "[INFO] $*"; }
warn() { printf '%s\n' "[WARN] $*" >&2; }
err() { printf '%s\n' "[ERROR] $*" >&2; }

echo "Running DevPod dotfiles install script..."

# --- Install chezmoi & configure dotfile ---
if sh -c "$(curl -fsLS get.chezmoi.io)" -- init --apply git@github.com:francisco-cardenas/DevPod-dots.git; then
  log "Installed chezmoi and ran init apply successfully"
  log "cleaning up binary of chezmoi. Chezmoi is to be used from mise install."

  # This install of chezmoi is temporary for the bootstrap. Mise will finish installing it
  rm -rf bin # Testing without removal
else
  err "Failed to install chezmoi or run init --apply" >&2
  exit 1
fi

# --- Switch to zsh if available ---
USER_NAME="$(whoami)"
ZSH_BIN="$(command -v zsh || true)"

log "Changing login shell for $USER_NAME to $ZSH_BIN"
if sudo -n chsh -s "$ZSH_BIN" "$USER_NAME"; then
  log "Shell changed successfully for $USER_NAME"
else
  err "Failed to change shell (need root or passwordless sudo)"
  exit 1
fi

# --- Ghostty terminfo ---
# Detect script path in both bash and zsh
if [ -n "${BASH_SOURCE:-}" ]; then
  # Bash
  SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
elif [ -n "${ZSH_VERSION:-}" ]; then
  # Zsh
  SCRIPT_PATH="$(readlink -f -- "${(%):-%N}")"
else
  # Fallback (POSIX)
  SCRIPT_PATH="$(readlink -f -- "$0")"
fi

SCRIPT_DIR="$(dirname -- "$SCRIPT_PATH")"

compile_terminfo_if_missing() {
  local name="$1" file="$2" outdir="${3:-$HOME/.terminfo}"

  # If already present, bail out early
  if infocmp -x "$name" >/dev/null 2>&1; then
    log "Terminfo present: $name"
    return 0
  fi

  # Resolve file to absolute path if it's relative
  if [[ "$file" != /* ]]; then
    file="$SCRIPT_DIR/$file"
  fi

  # Fallback: also try chezmoi working tree if vendored there
  if [[ ! -f "$file" ]]; then
    local cm="$HOME/.local/share/chezmoi/script/terminfo/$(basename "$file")"
    if [[ -f "$cm" ]]; then
      file="$cm"
    fi
  fi

  if [[ ! -f "$file" ]]; then
    warn "Vendored terminfo file missing: $file
[debug] pwd=$(pwd)
[debug] script_dir=$SCRIPT_DIR
[debug] ls -la script_dir:
$(ls -la "$SCRIPT_DIR" 2>/dev/null || true)
"
    return 1
  fi

  mkdir -p "$outdir"
  log "Installing terminfo: $name -> $outdir (source: $file)"
  if ! tic -x -o "$outdir" "$file"; then
    err "tic failed for $name ($file)"
    return 1
  fi

  # Verify installation
  if infocmp -x "$name" >/dev/null 2>&1; then
    log "Installed terminfo entry: $name"
    return 0
  else
    warn "tic completed but infocmp still cannot find: $name"
    return 1
  fi
}

# Call with path relative to *this* script file
compile_terminfo_if_missing xterm-ghostty "terminfo/xterm-ghostty.ti"

# --- Exit ---
echo "[OK] Bootstrap complete."
